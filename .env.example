# Copy this file to .env and fill in your own local values:
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env
#
# .env is git-ignored, so your values stay on your machine only —
# don't edit config/database.js directly to set your database name,
# and never commit a real .env file.

# ---- Server ----
PORT=3000
# Signs the login session cookie. Any random string works locally.
SESSION_SECRET=change-me-locally

# ---- Database (required) ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_oa

# ---- Email (optional) ----
# Leave these blank to skip sending emails locally — the app logs
# "[EMAIL] SMTP not configured. Email skipped." and continues normally.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# ---- Reports (optional) ----
# Where generated Excel/PDF reports are written.
# Defaults to Focusinsight-reports/ inside the project if not set.
REPORTS_DIR=
